{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-unisonos.github.io/schemas/hardware-bom.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "currency", "priced_at", "items"],
  "properties": {
    "schema_version": {"const": "unison-hardware-bom.v1"},
    "revision": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "priced_at": {"type": "string", "format": "date"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "category", "quantity", "unit_cost_estimate", "source", "lifecycle", "estimate_status", "power_watts", "thermal_watts", "substitution_notes"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "manufacturer_part_number": {"type": ["string", "null"]},
          "quantity": {"type": "number", "exclusiveMinimum": 0},
          "unit_cost_estimate": {"type": "number", "minimum": 0},
          "source": {"type": "string", "minLength": 1},
          "lifecycle": {"enum": ["concept", "active", "not-recommended", "obsolete", "unknown"]},
          "estimate_status": {"enum": ["budgetary", "quoted", "purchased"]},
          "power_watts": {"type": "number", "minimum": 0},
          "thermal_watts": {"type": "number", "minimum": 0},
          "substitution_notes": {"type": "string"}
        }
      }
    }
  }
}
